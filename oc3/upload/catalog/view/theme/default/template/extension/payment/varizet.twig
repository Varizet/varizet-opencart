<div class="varizet-payment" dir="{{ direction }}">
  <p>{{ text_instruction }}</p>
  <div class="buttons">
    <div class="pull-right">
      <button type="button" id="button-confirm" data-loading-text="..." class="btn btn-primary">{{ button_confirm }}</button>
    </div>
  </div>
  <div id="varizet-error" class="alert alert-danger" style="display:none"></div>
</div>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function () {
  var $b = $(this);
  $.ajax({
    url: '{{ confirm }}',
    dataType: 'json',
    beforeSend: function () { $b.button('loading'); },
    complete: function () { $b.button('reset'); },
    success: function (json) {
      if (json.redirect) { location = json.redirect; }
      if (json.error) { $('#varizet-error').text(json.error).show(); }
    }
  });
});
//--></script>
