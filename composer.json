{
    "name": "varizet/varizet-opencart",
    "description": "Varizet payment extension for OpenCart 3.x and 4.x. Dev tooling only: the zips ship the SDK.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Varizet\\OpenCart\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "sort-packages": true
    }
}
